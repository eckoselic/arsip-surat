# Isi dari Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Buat sendiri, bebas, minimal 8 karakter. Ini kode masuk untuk masing-masing peran.
TU_PASSCODE=gantidenganpasscoderahasia
KEPSEK_PASSCODE=gantidenganpasscoderahasia2

# String acak panjang untuk menandatangani session cookie (boleh generate lewat: openssl rand -hex 32)
SESSION_SECRET=gantidengan32karakterhexrandom
